{
  "manifest_version": 3,
  "name": "Nail360PRO Support Toolkit",
  "short_name": "N360 Support",
  "version": "2.1.0",
  "description": "N360 Support: module-based DEV checks, data comparison and bug reports.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Nail360PRO Support Toolkit"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "host_permissions": [
    "https://dev.nail360.info/*"
  ]
}
