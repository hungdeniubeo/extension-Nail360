{
  "manifest_version": 3,
  "name": "Nail360PRO Support Toolkit",
  "short_name": "N360 Support",
  "version": "1.2.2",
  "description": "Read-only DEV bug scan, business checks, regression, comparison and local QA dashboard.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "alarms"
  ],
  "action": {
    "default_title": "Nail360PRO Support Toolkit"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "host_permissions": [
    "https://dev.nail360.info/*"
  ]
}
